    <!-- 검색 전후 레코드 개수 -->
<select id="noti_count" parameterType="page" resultType="int">
  SELECT COUNT(notice_no)
  FROM Notice
  <where>
    <if test="findField != null and findName != null and findName != ''">
      AND ${findField} LIKE '%' || #{findName} || '%'
    </if> 
  </where>
</select>

  <!-- 검색 및 페이징 목록 -->

<select id="noti_list" parameterType="com.spike.dto.NotiPageDTO" resultMap="NoticeResultMap">

  SELECT * FROM (
    SELECT rownum AS rNum, notice_no, notice_name, notice_title, notice_hit, created_date
    FROM (
      SELECT * FROM notice
      <where>
        <if test="findField == ''"></if> <!-- 검색 조건이 없으면 모든 데이터를 가져옴 -->
        <if test="findField == 'notice_title'">
          notice_title LIKE #{findName}
        </if>
        <if test="findField == 'notice_cont'">
          notice_cont LIKE #{findName}
        </if>
      </where>
      ORDER BY notice_no DESC, created_date DESC
    )
  ) WHERE rNum BETWEEN #{startrow} AND #{endrow}
</select>

